<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de este dispositivo"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ej. celu-lucho"
            android:inputType="text"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grupo (clave). La misma clave = mismo grupo."
            android:textStyle="bold" />

        <EditText
            android:id="@+id/key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="vacío = grupo general"
            android:inputType="text"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unirme a un grupo escaneando QR (usá el escáner que te funcione)"
            android:textStyle="bold" />

        <Button
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Escáner vertical (ZXing)" />

        <Button
            android:id="@+id/scanHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Escáner horizontal (ZXing)" />

        <Button
            android:id="@+id/scanGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Escáner de Google (ML Kit)" />

        <Button
            android:id="@+id/myQr"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📱 Mostrar mi QR (que me escaneen)" />

        <Button
            android:id="@+id/pickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Elegir carpeta donde guardar" />

        <TextView
            android:id="@+id/folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carpeta: (sin elegir)"
            android:textSize="12sp"
            android:textColor="#77736A"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/lightMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Modo claro (por defecto es oscuro)" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Antes de empezar"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1) Carpeta donde se guardan los archivos recibidos"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pickFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elegir carpeta" />

        <TextView
            android:id="@+id/folderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✗ sin elegir"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2) Conectate: escaneá el QR de otra PC o celu, o creá tu propio grupo."
            android:textStyle="bold" />

        <Button
            android:id="@+id/scanVertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Escáner vertical (ZXing)" />

        <Button
            android:id="@+id/scanHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Escáner horizontal (ZXing)" />

        <Button
            android:id="@+id/scanGoogle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Escáner de Google (ML Kit)" />

        <Button
            android:id="@+id/createGroup"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="➕ Crear mi propio grupo (sin escanear)" />

        <TextView
            android:id="@+id/qrStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✗ sin vincular"
            android:textColor="?android:attr/textColorSecondary"
            android:paddingTop="6dp"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Empezar"
            android:enabled="false" />

        <Button
            android:id="@+id/exit"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Salir" />
    </LinearLayout>
</ScrollView>
